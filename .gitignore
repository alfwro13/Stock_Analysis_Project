.backup_*/
.restore_*/

# Ignore Ghostfolio ha integration files - here only for the migration
ghostfolio_ha_integration/
Stock_Analysis_Project_ha_integration/

# Dependabot reads package.json; nothing is ever installed from it
node_modules/

